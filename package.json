{
  "name": "paris-eiffel-walk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "First-person walk around the Eiffel Tower built from open data (OSM, IGN, Paris Data)",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test \"shared/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "bake": "tsx scripts/bake.ts",
    "bake:osm": "tsx scripts/bake.ts --step=osm",
    "bake:bdtopo": "tsx scripts/bake.ts --step=bdtopo",
    "bake:terrain": "tsx scripts/bake.ts --step=terrain",
    "bake:ortho": "tsx scripts/bake.ts --step=ortho",
    "bake:masks": "tsx scripts/bake.ts --step=masks",
    "bake:trees": "tsx scripts/bake.ts --step=trees",
    "bake:assets": "tsx scripts/bake.ts --step=assets",
    "bake:eiffel": "tsx scripts/bake.ts --step=eiffel",
    "bake:towerwalk": "tsx scripts/bake.ts --step=towerwalk",
    "bake:build": "tsx scripts/bake.ts --step=build",
    "bake:paths": "tsx scripts/bake.ts --step=paths",
    "bake:deshadow": "tsx scripts/bake.ts --step=deshadow",
    "bake:markings": "tsx scripts/bake.ts --step=markings",
    "bake:streets": "tsx scripts/bake.ts --step=streets",
    "bake:far": "tsx scripts/bake.ts --step=far",
    "compress": "tsx scripts/compress.ts dist",
    "build:compressed": "vite build && tsx scripts/compress.ts dist"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "lil-gui": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.4",
    "stats-gl": "^4.2.0",
    "suncalc": "^2.0.2",
    "three": "~0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "~0.185.0",
    "earcut": "^3.2.3",
    "fflate": "^0.8.2",
    "meshoptimizer": "^1.2.0",
    "osmtogeojson": "3.0.0-beta.5",
    "p-limit": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
